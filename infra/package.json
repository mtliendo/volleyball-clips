{
  "name": "volleyball-clips-infra",
  "private": true,
  "scripts": {
    "prepare-ffmpeg": "bash scripts/prepare-ffmpeg-layer.sh",
    "prepare-lambda-deps": "bash scripts/prepare-lambda-deps.sh",
    "build": "tsc --noEmit",
