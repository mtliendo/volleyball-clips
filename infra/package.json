    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.16.0",
    "aws-cdk": "^2.1108.0",
    "esbuild": "^0.27.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
