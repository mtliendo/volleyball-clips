# Neon (pooled for the app, unpooled for drizzle-kit migrate)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth0 Regular Web Application
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Display timezone for the calendar and datetime-local forms
APP_TIMEZONE=America/Chicago

# From VolleyballClipsStack CloudFormation outputs
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_ROLE_ARN=
NEXT_PUBLIC_CDN_URL=

# Decrypted value of SSM SecureString /volleyball-clips/transcode-webhook-secret
# (stack output TRANSCODE_WEBHOOK_SECRET_PARAMETER). Not a CloudFormation secret.
TRANSCODE_WEBHOOK_SECRET=

# Local-only alternative to Vercel OIDC (do not set these on Vercel)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
