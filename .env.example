# Neon (pooled for the app, unpooled for drizzle-kit migrate)
# Never point migrate at production when testing schema changes. Use a Neon branch.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth0 Regular Web Application (tenant vb-pov.us.auth0.com)
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=vb-pov.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Display timezone for the calendar and datetime-local forms
APP_TIMEZONE=America/Chicago

# From VolleyballClipsStack CloudFormation outputs
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_ROLE_ARN=
NEXT_PUBLIC_CDN_URL=

# Decrypted value of SSM SecureString /volleyball-clips/transcode-webhook-secret
TRANSCODE_WEBHOOK_SECRET=

# Optional. HMAC secret for anonymous watch IP backstop. Falls back to AUTH0_SECRET.
ANON_HASH_SECRET=

# Stripe TEST mode. The app degrades if these are missing: pricing still renders,
# checkout and portal return 503, webhooks return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional Customer Portal configuration (bpc_...). Omit to use the Stripe default.
STRIPE_PORTAL_CONFIG_ID=

# Local-only alternative to Vercel OIDC (do not set these on Vercel)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
